{
  "openapi": "3.1.0",
  "info": {
    "title": "DBRover Local API",
    "version": "0.1.0-dev",
    "description": "回环 HTTP 契约。除标注 public 的端点外均需 X-DBRover-Token。本文件是唯一真相，由 TestSpecMatchesRoutes 与路由表逐条比对。"
  },
  "servers": [
    { "url": "http://127.0.0.1:7788", "description": "默认仅监听回环" }
  ],
  "security": [{ "TokenAuth": [] }],
  "components": {
    "securitySchemes": {
      "TokenAuth": { "type": "apiKey", "in": "header", "name": "X-DBRover-Token" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "category", "message", "retryable"],
            "properties": {
              "code": { "type": "string" },
              "category": {
                "type": "string",
                "enum": ["connection", "auth", "permission", "syntax", "constraint", "timeout", "canceled", "resource", "policy", "internal"]
              },
              "message": { "type": "string" },
              "hint": { "type": "string" },
              "retryable": { "type": "boolean" },
              "request_id": { "type": "string" }
            }
          }
        }
      },
      "Connection": {
        "type": "object",
        "required": ["id", "engine", "environment", "access_mode"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "engine": { "type": "string" },
          "environment": { "type": "string", "enum": ["local", "test", "staging", "production", "unknown"] },
          "access_mode": { "type": "string", "enum": ["read-only", "read-write", "admin"] },
          "display_timezone": { "type": "string", "description": "展示时区；缺省表示按 UTC" }
        }
      },
      "Column": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "object",
            "properties": {
              "kind": { "type": "string" },
              "raw": { "type": "string" }
            }
          },
          "nullable": { "type": "boolean" },
          "is_primary": { "type": "boolean" }
        }
      },
      "StatementResult": {
        "type": "object",
        "properties": {
          "index": { "type": "integer" },
          "sql": { "type": "string" },
          "grade": {
            "type": "object",
            "properties": {
              "level": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"] },
              "reason": { "type": "string" },
              "writes": { "type": "boolean" }
            }
          },
          "columns": { "type": "array", "items": { "$ref": "#/components/schemas/Column" } },
          "rows": { "type": "array", "items": { "type": "array" } },
          "affected": { "type": "integer" },
          "duration_ms": { "type": "integer" },
          "err": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "存活探测",
        "security": [],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "本契约文件",
        "security": [],
        "responses": { "200": { "description": "OpenAPI 文档" } }
      }
    },
    "/api/v1/connections": {
      "get": {
        "summary": "连接列表",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Connection" } } }
                }
              }
            }
          },
          "401": { "description": "缺少或错误的令牌", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "summary": "创建并打开连接",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["engine", "host"],
                "properties": {
                  "name": { "type": "string" },
                  "engine": {
                    "type": "string",
                    "enum": ["sqlite", "mysql", "postgres", "redis"],
                    "description": "sqlite 时 host 是数据库文件路径；其余引擎按网络连接处理"
                  },
                  "host": { "type": "string", "description": "文件路径或主机名" },
                  "port": { "type": "integer", "description": "网络引擎必填" },
                  "catalog": { "type": "string", "description": "库名；与 schema 是两件事" },
                  "schema": {
                    "type": "string",
                    "description": "schema，留空则由引擎取默认值（PostgreSQL 为 public）。不要传库名"
                  },
                  "user": { "type": "string" },
                  "password": {
                    "type": "string",
                    "description": "只进不出：请求里出现一次，之后任何响应都不回显"
                  },
                  "environment": { "type": "string", "enum": ["local", "test", "staging", "production", "unknown"] },
                  "access_mode": { "type": "string", "enum": ["read-only", "read-write", "admin"] },
                  "display_timezone": {
                    "type": "string",
                    "description": "时间值的展示时区，IANA 名（如 Asia/Shanghai）；留空按 UTC。只影响展示：会话时区固定 UTC，写进去的就是 UTC。名字不合法返回 400，不做静默退回"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "已创建", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Connection" } } } },
          "400": { "description": "请求非法" },
          "502": { "description": "连接失败" }
        }
      }
    },
    "/api/v1/connections/{id}": {
      "delete": {
        "summary": "关闭并移除连接",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "已删除" }, "404": { "description": "不存在" } }
      }
    },
    "/api/v1/connections/{id}/health": {
      "get": {
        "summary": "连接健康与服务器身份",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok" }, "404": { "description": "不存在" } }
      }
    },
    "/api/v1/connections/{id}/tables": {
      "get": {
        "summary": "表与视图清单",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok" }, "404": { "description": "不存在" } }
      }
    },
    "/api/v1/connections/{id}/tables/{name}/rows": {
      "get": {
        "summary": "表数据浏览（键集分页）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 1000 } },
          { "name": "after", "in": "query", "description": "上一页最后一行定位值，JSON 字符串数组，顺序与「排序列…, 主键…」一致", "schema": { "type": "string" } },
          { "name": "where", "in": "query", "description": "AND 组合的筛选条件，JSON 数组；列名必须在表定义中，操作符取值 eq/ne/gt/ge/lt/le/like/is_null/is_not_null", "schema": { "type": "string" } },
          { "name": "order", "in": "query", "description": "单列排序，JSON 对象，如 {\"column\":\"id\",\"desc\":true}；主键始终追加在排序键末尾", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "columns": { "type": "array", "items": { "$ref": "#/components/schemas/Column" } },
                    "rows": { "type": "array", "items": { "type": "array" } },
                    "next": { "type": "array", "items": { "type": "string" } },
                    "has_more": { "type": "boolean" },
                    "primary_key": { "type": "array", "items": { "type": "string" }, "description": "主键列名；为空表示该表不可编辑" },
                    "editable": { "type": "boolean", "description": "是否允许行内编辑（需有主键且连接可写）" }
                  }
                }
              }
            }
          },
          "400": { "description": "筛选或排序参数不合法（FILTER_INVALID / REQUEST_INVALID）" },
          "501": { "description": "无主键表不支持键集分页（CAPABILITY_UNSUPPORTED）" }
        }
      }
    },
    "/api/v1/connections/{id}/tables/{name}/schema": {
      "get": {
        "summary": "表结构详情与 DDL 原文",
        "description": "DDL 还原失败时仍返回结构，另给 ddl_error，不让整页打不开。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "schema", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "ok" },
          "400": { "description": "读取结构失败（SCHEMA_READ_FAILED）" },
          "404": { "description": "连接不存在" }
        }
      }
    },
    "/api/v1/connections/{id}/schema/plan": {
      "post": {
        "summary": "生成结构变更预案",
        "description": "v1 支持 create_table / add_column / drop_column / alter_column_type / create_index / drop_index / add_foreign_key / drop_table。执行走同一个 /changes/{pid}/apply；预案带表定义哈希（建表则要求执行时表仍不存在），变了就返回 409 SCHEMA_CHANGED。建表必须给主键。改列类型前会做收窄预检，装不下现存数据返回 409 NARROWING_BLOCKED；SQLite 不支持原地改类型，返回 400。加外键前先查孤儿数据与父表列唯一性，不通过返回 409 FK_PRECHECK_BLOCKED 并带样本；SQLite 不支持 ALTER TABLE 加约束，返回 400。删表/删列前先查依赖（视图与入向外键），仍被引用返回 409 DEPENDENCY_BLOCKED；删表必然不可逆，回滚语句只是把空表建回来。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["table", "action"],
                "properties": {
                  "table": { "type": "object" },
                  "action": { "type": "string", "enum": ["create_table", "add_column", "drop_column", "alter_column_type", "create_index", "drop_index", "add_foreign_key", "drop_table"] },
                  "column": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string", "description": "原始类型文本，白名单约束" },
                      "nullable": { "type": "boolean" },
                      "default": { "type": "string", "description": "只接受字面量" }
                    }
                  },
                  "columns": { "type": "array", "items": { "type": "object" }, "description": "create_table 用" },
                  "primary_key": { "type": "array", "items": { "type": "string" }, "description": "create_table 用，必须非空" },
                  "index": {
                    "type": "object",
                    "description": "create_index / drop_index 用；drop 时只需 name",
                    "properties": {
                      "name": { "type": "string" },
                      "columns": { "type": "array", "items": { "type": "string" } },
                      "unique": { "type": "boolean" }
                    }
                  },
                  "foreign_key": {
                    "type": "object",
                    "description": "add_foreign_key 用。生成预案前会先查孤儿数据与父表唯一性，不满足直接 409 并带样本；name 为空时按「fk_<表>_<列>」生成确定名字（回滚要靠它摘约束）",
                    "required": ["columns", "ref_table", "ref_columns"],
                    "properties": {
                      "name": { "type": "string" },
                      "columns": { "type": "array", "items": { "type": "string" } },
                      "ref_table": { "type": "string" },
                      "ref_columns": { "type": "array", "items": { "type": "string" } },
                      "on_delete": { "type": "string", "enum": ["", "CASCADE", "RESTRICT", "NO ACTION", "SET NULL"] },
                      "on_update": { "type": "string", "enum": ["", "CASCADE", "RESTRICT", "NO ACTION", "SET NULL"] }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "预案已生成（语句 / 回滚 / 风险 / 摩擦 / 不可逆标记）" },
          "400": { "description": "参数不合法（INVALID_COLUMN）或生成失败（SCHEMA_PLAN_FAILED）；引擎不支持该动作也走 400（例如 SQLite 的 alter_column_type 与 add_foreign_key）" },
          "409": { "description": "收窄预检不通过（NARROWING_BLOCKED）、唯一索引前发现重复值（DUPLICATE_ROWS）、外键预检不通过（FK_PRECHECK_BLOCKED：有孤儿数据或父表列不唯一，带样本），目标仍被引用（DEPENDENCY_BLOCKED：被视图或入向外键引用，提示里带近似标记），或已有会话在等锁（LOCK_WAIT_BLOCKED：长事务只写进 notes，锁等待才阻断）" },
          "404": { "description": "连接不存在" }
        }
      }
    },
    "/api/v1/connections/{id}/exec": {
      "post": {
        "summary": "执行 SQL（一次性，行数有上限）",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sql"],
                "properties": {
                  "sql": { "type": "string" },
                  "approval_token": {
                    "type": "string",
                    "description": "服务端在 428 响应里签发的审批凭证，绑定语句指纹与 10 分钟有效期。不接受布尔值。"
                  },
                  "max_rows": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "execution_id": { "type": "string" },
                    "risk": { "type": "string" },
                    "friction": { "type": "string" },
                    "duration_ms": { "type": "integer" },
                    "results": { "type": "array", "items": { "$ref": "#/components/schemas/StatementResult" } }
                  }
                }
              }
            }
          },
          "400": { "description": "请求非法" },
          "403": { "description": "只读连接拒绝写入（POLICY_READ_ONLY）" },
          "409": { "description": "审批凭证无效、过期或与语句不匹配（POLICY_APPROVAL_MISMATCH）" },
          "428": {
            "description": "需要确认（POLICY_APPROVAL_REQUIRED），错误体携带 approval.token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "approval": {
                          "type": "object",
                          "properties": {
                            "statement_hash": { "type": "string" },
                            "expires_at": { "type": "string", "format": "date-time" },
                            "token": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connections/{id}/query": {
      "post": {
        "summary": "打开流式游标（仅单条只读语句）",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sql"],
                "properties": {
                  "sql": { "type": "string" },
                  "fetch_size": { "type": "integer", "description": "驱动侧批大小，默认 200" },
                  "max_rows": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "游标已打开",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "execution_id": { "type": "string" },
                    "cursor_id": { "type": "string" },
                    "columns": { "type": "array", "items": { "$ref": "#/components/schemas/Column" } },
                    "risk": { "type": "string" },
                    "friction": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "写语句或多语句被拒绝" }
        }
      }
    },
    "/api/v1/results/{cid}/page": {
      "get": {
        "summary": "拉取一页结果",
        "parameters": [
          { "name": "cid", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 200 } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rows": { "type": "array", "items": { "type": "array" } },
                    "has_more": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "409": { "description": "游标正被读取（CURSOR_BUSY）" },
          "410": { "description": "游标已关闭或过期（CURSOR_CLOSED）" }
        }
      }
    },
    "/api/v1/results/{cid}": {
      "delete": {
        "summary": "主动关闭游标",
        "parameters": [{ "name": "cid", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "已关闭" } }
      }
    },
    "/api/v1/connections/{id}/changes/plan": {
      "post": {
        "summary": "生成数据变更预案（不执行）",
        "description": "预案由服务端保管，客户端只能用 id 回来执行。无主键表返回 501。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["table", "changes"],
                "properties": {
                  "table": {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string" },
                      "schema": { "type": "string" },
                      "name": { "type": "string" }
                    }
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["op"],
                      "properties": {
                        "op": { "type": "string", "enum": ["insert", "update", "delete"] },
                        "key": { "type": "object" },
                        "before": { "type": "object", "description": "原值，用于乐观并发校验与回滚" },
                        "after": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "预案已生成（含 statements / rollback / risk / friction）" },
          "400": { "description": "变更集非法（CHANGE_PLAN_FAILED / NUMBER_PRECISION_LOSS：大整数写成了 JSON 数字且超过 2^53，改用字符串重传）" },
          "501": { "description": "无主键表不支持（CAPABILITY_UNSUPPORTED）" }
        }
      }
    },
    "/api/v1/changes/{pid}/apply": {
      "post": {
        "summary": "执行数据变更预案",
        "description": "单事务执行；任一条影响行数不符即整体回滚并返回 409。影响行数超过单批上限的批量修改改为按主键键集分批执行：每批一个独立事务，中途失败或中止时已提交的批不回滚，返回的 rows_affected 是实际提交的行数。带 ?stream=1 时用 application/x-ndjson 逐批回报 {\"type\":\"progress\",\"done\",\"total\"}，最后一行是 {\"type\":\"result\"} 或 {\"type\":\"error\"}；一旦进度开始，状态码就固定为 200，错误只能出现在 error 行里。",
        "parameters": [
          { "name": "pid", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "stream", "in": "query", "description": "1 表示用 NDJSON 回报进度；没有进度可报时仍是普通 JSON", "schema": { "type": "string", "enum": ["0", "1"] } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "approval_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已应用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "execution_id": { "type": "string" },
                    "risk": { "type": "string" },
                    "friction": { "type": "string" },
                    "duration_ms": { "type": "integer" },
                    "rows_affected": { "type": "integer", "description": "实际提交的行数" },
                    "undo": {
                      "description": "撤销预案（10 分钟内有效）；不可逆变更或撤销本身为 null",
                      "oneOf": [
                        { "type": "null" },
                        {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string", "description": "把它 POST 回 apply 端点即撤销" },
                            "expires_at": { "type": "string", "format": "date-time" },
                            "statements": { "type": "array", "items": { "type": "object" } }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "application/x-ndjson": { "schema": { "type": "string" } }
            }
          },
          "404": { "description": "预案不存在或已清理" },
          "409": {
            "description": "行冲突（CHANGE_ROW_CONFLICT）、审批凭证不匹配，或分批执行被中止（CHANGE_APPLY_ABORTED：已提交的批不回滚，预案仍有效可重新提交）"
          },
          "428": { "description": "需要确认（POLICY_APPROVAL_REQUIRED）" }
        }
      }
    },
    "/api/v1/connections/{id}/export": {
      "get": {
        "summary": "流式导出表数据（CSV / NDJSON）",
        "description": "单条 SELECT 走游标分批取，内存上限由 page_size 决定。不需要主键，视图与无主键表也能导。CSV 的 NULL 写成空串（与空字符串文本上不可区分）；NDJSON 的 NULL 是真正的 null，BigInt 与二进制分别以字符串、base64 输出以保精度与字节安全。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "table", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["csv", "ndjson"], "default": "csv" } },
          { "name": "header", "in": "query", "description": "CSV 是否写表头，0 表示不写", "schema": { "type": "string", "default": "1" } },
          { "name": "where", "in": "query", "description": "筛选条件，JSON 数组，与 rows 端点同构", "schema": { "type": "string" } },
          { "name": "order", "in": "query", "description": "排序，JSON 对象", "schema": { "type": "string" } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 500, "maximum": 1000 } }
        ],
        "responses": {
          "200": {
            "description": "文件流。导出行数记在审计里（流写完才知道行数，无法作为响应头返回）。",
            "content": {
              "text/csv": { "schema": { "type": "string" } },
              "application/x-ndjson": { "schema": { "type": "string" } }
            }
          },
          "400": { "description": "参数不合法（EXPORT_FORMAT_UNSUPPORTED / FILTER_INVALID / EXPORT_FAILED）" },
          "404": { "description": "连接不存在" }
        }
      }
    },
    "/api/v1/connections/{id}/bulk/plan": {
      "post": {
        "summary": "生成条件批量修改预案",
        "description": "按条件一次改多行。与数据变更集共用同一个 apply 端点：行数校验、事务回滚、审批逻辑完全一致。影响行数在生成预案时精确统计并写入 expect_rows，执行时行数不符即整体回滚。无 where 时等于全表写，必须回填 confirm_table；影响超过 1000 行时不生成逐行回滚，必须显式接受 accept_no_rollback。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["table", "set"],
                "properties": {
                  "table": { "type": "object" },
                  "set": { "type": "object", "description": "列名 → 新值；null 表示设为 NULL" },
                  "filter": { "type": "array", "items": { "type": "object" }, "description": "与 rows 端点的 where 同构" },
                  "confirm_table": { "type": "string", "description": "无 filter 时必须等于表名" },
                  "accept_no_rollback": { "type": "boolean", "description": "影响超过 1000 行时必须为 true" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "预案已生成：plan（语句/回滚/风险/摩擦）+ affected + samples 前后对比 + note；影响超过单批上限且是单列主键时 batched 为 true，并给出 batch_size 与 batches（执行时按主键键集分批，每批独立提交，中途失败或中止不回滚已提交的批）。复合主键与无主键表不分批，走单事务。"
          },
          "400": { "description": "参数不合法（REQUEST_INVALID / FILTER_INVALID / BULK_PLAN_FAILED / NUMBER_PRECISION_LOSS：大整数写成了 JSON 数字且超过 2^53，改用字符串重传）" },
          "428": { "description": "需要额外确认（BULK_CONFIRM_TABLE_REQUIRED / BULK_NO_ROLLBACK_ACK）" }
        }
      }
    },
    "/api/v1/connections/{id}/kv/keys": {
      "get": {
        "summary": "遍历 key（SCAN）",
        "description": "key-value 连接专用。用 SCAN 游标而不是 KEYS：后者会阻塞整个实例，集群模式下还没有它。对关系型连接调用返回 400 CAPABILITY_UNSUPPORTED。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "description": "上一页返回的游标；空表示从头", "schema": { "type": "string" } },
          { "name": "pattern", "in": "query", "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["string", "hash", "list", "set", "zset", "stream"] } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 200 } }
        ],
        "responses": {
          "200": {
            "description": "一页 key。has_more 为 true 时 cursor 才有意义",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "keys": { "type": "array", "items": { "type": "string" } },
                "cursor": { "type": "string" },
                "has_more": { "type": "boolean" }
              }
            } } }
          },
          "400": { "description": "关系型连接调用了 kv 端点（CAPABILITY_UNSUPPORTED）" },
          "502": { "description": "SCAN 失败（KV_SCAN_FAILED）" }
        }
      }
    },
    "/api/v1/connections/{id}/kv/entry": {
      "get": {
        "summary": "读一个 key 的元信息",
        "description": "类型 / TTL / 编码 / 元素数 / 体积。体积取不到时 size_bytes 缺失（不写 0）——MEMORY USAGE 在大 key 上可能超时。key 用查询参数传，因为 Redis 的 key 是二进制安全的，斜杠与空格都合法。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "key", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "类型 / ttl_seconds（-1 永不过期、-2 不存在）/ length / size_bytes / preview" },
          "400": { "description": "缺少 key 或连接不是 key-value" },
          "502": { "description": "读取失败（KV_INSPECT_FAILED）" }
        }
      }
    },
    "/api/v1/connections/{id}/kv/value": {
      "get": {
        "summary": "按类型分页读值",
        "description": "string 用 GETRANGE 限长（默认 8 KB）并显式给 truncated；hash/set 用 HSCAN/SSCAN；zset/list 按名次分页；stream 用 XRANGE。位图 / HLL / geo / 模块类型只返回类型，不假装能编辑。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "key", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 100 } },
          { "name": "max_bytes", "in": "query", "description": "只对 string 生效", "schema": { "type": "integer", "default": 8192 } }
        ],
        "responses": {
          "200": { "description": "值 + cursor / has_more / truncated" },
          "400": { "description": "缺少 key 或连接不是 key-value" },
          "502": { "description": "读取失败（KV_VALUE_FAILED）" }
        }
      }
    },
    "/api/v1/connections/{id}/kv/command": {
      "post": {
        "summary": "命令模式（第一版只放行只读命令）",
        "description": "结构化命令名 + 参数，不做自由文本解析。走与 SQL 同一套执行门：风险分级（ADR-0007 §3）→ 摩擦 → 审批 → 审计。需要确认的命令返回 428 并签发绑定**命令指纹**的凭证；只读连接上的写命令返回 403 POLICY_READ_ONLY（与 SQL 同一条规则）；KEYS 与 DEBUG 直接 403 POLICY_COMMAND_BLOCKED 并给替代方案。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "description": "命令名，如 GET / TTL / SCAN" },
              "args": { "type": "array", "items": {} },
              "approval_token": { "type": "string", "description": "428 响应里签发的凭证，绑定命令指纹" }
            }
          } } }
        },
        "responses": {
          "200": { "description": "命令结果：risk / friction / result（result.changed=-1 表示未知）" },
          "400": { "description": "请求非法或连接不是 key-value" },
          "403": { "description": "命令被拒（POLICY_COMMAND_BLOCKED / POLICY_READ_ONLY）" },
          "409": { "description": "审批凭证与当前命令不匹配（POLICY_APPROVAL_MISMATCH）" },
          "428": { "description": "需要确认（POLICY_APPROVAL_REQUIRED），带 approval.token" },
          "502": { "description": "执行失败" }
        }
      }
    },    "/api/v1/connections/{id}/kv/apply": {
      "post": {
        "summary": "key-value 结构化写操作",
        "description": "一次写一个 key（SET / HSET / DEL / HDEL / RPUSH / EXPIRE）。与命令模式共用同一道门：分级 → 摩擦 → 审批 → 审计。「命令模式的写」还没有单独开放——写要走这里，因为它带着明确的操作语义，比一条裸命令更容易分级与审计。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["mutation"],
            "properties": {
              "mutation": {
                "type": "object",
                "required": ["kind", "key"],
                "properties": {
                  "kind": { "type": "string", "enum": ["set_string", "set_field", "delete_key", "delete_item", "push", "expire"] },
                  "key": { "type": "string" },
                  "field": { "type": "string" },
                  "value": { "type": "string" },
                  "member": { "type": "string" },
                  "ttl_seconds": { "type": "integer" }
                }
              },
              "approval_token": { "type": "string" }
            }
          } } }
        },
        "responses": {
          "200": { "description": "已执行：risk / friction / result" },
          "400": { "description": "请求非法或连接不是 key-value" },
          "403": { "description": "被策略拒绝（POLICY_READ_ONLY / POLICY_COMMAND_BLOCKED）" },
          "409": { "description": "审批凭证与当前操作不匹配（POLICY_APPROVAL_MISMATCH）" },
          "428": { "description": "需要确认（POLICY_APPROVAL_REQUIRED）" }
        }
      }
    },    "/api/v1/compare": {
      "post": {
        "summary": "比对两个连接的结构",
        "description": "只读：不生成预案、不改任何一边。返回每张表的状态（only_left / only_right / changed / need_review）与逐列差异原因。索引参与比对，按「列序列 + 唯一性 + 谓词」为键、不按名字；只改索引名或访问方法不生成脚本而进 need_review。列的删除与改类型一律进 need_review；索引的增删因为不丢数据，upgrade 与 downgrade 两个方向都给脚本。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["left", "right"],
                "properties": {
                  "left": { "type": "string", "description": "左侧连接 id" },
                  "right": { "type": "string", "description": "右侧连接 id" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "比对结论：tables + upgrade + downgrade + need_review" },
          "400": { "description": "缺少 left / right（REQUEST_INVALID）" },
          "404": { "description": "连接不存在" },
          "502": { "description": "读取结构失败（COMPARE_FAILED）" }
        }
      }
    },
    "/api/v1/connections/{id}/fk/precheck": {
      "post": {
        "summary": "加外键前的孤儿数据预检（只读）",
        "description": "检查子表是否存在父表找不到对应行的数据，并判断父表参与列是否唯一（主键或列集合完全一致的唯一索引）。任一子列为 NULL 的行不计入孤儿。orphans>0 时 blocked=true 并给最多 5 条样本。注意：本端点不生成加外键的 DDL——SQLite 不支持 ALTER TABLE ADD CONSTRAINT，MySQL/PG 暂无可用真机验收。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["child", "parent", "columns", "ref_columns"],
                "properties": {
                  "child": { "type": "object" },
                  "parent": { "type": "object" },
                  "columns": { "type": "array", "items": { "type": "string" } },
                  "ref_columns": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "orphans / samples / parent_unique / blocked / reason" },
          "400": { "description": "参数不合法（REQUEST_INVALID）" },
          "404": { "description": "连接不存在" },
          "502": { "description": "预检执行失败（FK_PRECHECK_FAILED）" }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "summary": "审计事件",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "at": { "type": "string", "format": "date-time" },
                          "actor": { "type": "string" },
                          "risk": { "type": "string" },
                          "friction": { "type": "string" },
                          "outcome": { "type": "string", "enum": ["ok", "denied", "error"] },
                          "duration_ms": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
