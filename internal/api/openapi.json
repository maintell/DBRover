{
  "openapi": "3.1.0",
  "info": {
    "title": "DBRover Local API",
    "version": "0.1.0-dev",
    "description": "回环 HTTP 契约。除标注 public 的端点外均需 X-DBRover-Token。本文件是唯一真相，由 TestSpecMatchesRoutes 与路由表逐条比对。"
  },
  "servers": [
    { "url": "http://127.0.0.1:7788", "description": "默认仅监听回环" }
  ],
  "security": [{ "TokenAuth": [] }],
  "components": {
    "securitySchemes": {
      "TokenAuth": { "type": "apiKey", "in": "header", "name": "X-DBRover-Token" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "category", "message", "retryable"],
            "properties": {
              "code": { "type": "string" },
              "category": {
                "type": "string",
                "enum": ["connection", "auth", "permission", "syntax", "constraint", "timeout", "canceled", "resource", "policy", "internal"]
              },
              "message": { "type": "string" },
              "hint": { "type": "string" },
              "retryable": { "type": "boolean" },
              "request_id": { "type": "string" }
            }
          }
        }
      },
      "Connection": {
        "type": "object",
        "required": ["id", "engine", "environment", "access_mode"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "engine": { "type": "string" },
          "environment": { "type": "string", "enum": ["local", "test", "staging", "production", "unknown"] },
          "access_mode": { "type": "string", "enum": ["read-only", "read-write", "admin"] }
        }
      },
      "Column": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "object",
            "properties": {
              "kind": { "type": "string" },
              "raw": { "type": "string" }
            }
          },
          "nullable": { "type": "boolean" },
          "is_primary": { "type": "boolean" }
        }
      },
      "StatementResult": {
        "type": "object",
        "properties": {
          "index": { "type": "integer" },
          "sql": { "type": "string" },
          "grade": {
            "type": "object",
            "properties": {
              "level": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"] },
              "reason": { "type": "string" },
              "writes": { "type": "boolean" }
            }
          },
          "columns": { "type": "array", "items": { "$ref": "#/components/schemas/Column" } },
          "rows": { "type": "array", "items": { "type": "array" } },
          "affected": { "type": "integer" },
          "duration_ms": { "type": "integer" },
          "err": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "存活探测",
        "security": [],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "本契约文件",
        "security": [],
        "responses": { "200": { "description": "OpenAPI 文档" } }
      }
    },
    "/api/v1/connections": {
      "get": {
        "summary": "连接列表",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Connection" } } }
                }
              }
            }
          },
          "401": { "description": "缺少或错误的令牌", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "summary": "创建并打开连接",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["engine", "host"],
                "properties": {
                  "name": { "type": "string" },
                  "engine": { "type": "string", "enum": ["sqlite"] },
                  "host": { "type": "string" },
                  "environment": { "type": "string", "enum": ["local", "test", "staging", "production", "unknown"] },
                  "access_mode": { "type": "string", "enum": ["read-only", "read-write", "admin"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "已创建", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Connection" } } } },
          "400": { "description": "请求非法" },
          "502": { "description": "连接失败" }
        }
      }
    },
    "/api/v1/connections/{id}": {
      "delete": {
        "summary": "关闭并移除连接",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "已删除" }, "404": { "description": "不存在" } }
      }
    },
    "/api/v1/connections/{id}/health": {
      "get": {
        "summary": "连接健康与服务器身份",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok" }, "404": { "description": "不存在" } }
      }
    },
    "/api/v1/connections/{id}/tables": {
      "get": {
        "summary": "表与视图清单",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok" }, "404": { "description": "不存在" } }
      }
    },
    "/api/v1/connections/{id}/tables/{name}/rows": {
      "get": {
        "summary": "表数据浏览（键集分页）",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 1000 } },
          { "name": "after", "in": "query", "description": "上一页最后一行定位值，JSON 字符串数组，顺序与「排序列…, 主键…」一致", "schema": { "type": "string" } },
          { "name": "where", "in": "query", "description": "AND 组合的筛选条件，JSON 数组；列名必须在表定义中，操作符取值 eq/ne/gt/ge/lt/le/like/is_null/is_not_null", "schema": { "type": "string" } },
          { "name": "order", "in": "query", "description": "单列排序，JSON 对象，如 {\"column\":\"id\",\"desc\":true}；主键始终追加在排序键末尾", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "columns": { "type": "array", "items": { "$ref": "#/components/schemas/Column" } },
                    "rows": { "type": "array", "items": { "type": "array" } },
                    "next": { "type": "array", "items": { "type": "string" } },
                    "has_more": { "type": "boolean" },
                    "primary_key": { "type": "array", "items": { "type": "string" }, "description": "主键列名；为空表示该表不可编辑" },
                    "editable": { "type": "boolean", "description": "是否允许行内编辑（需有主键且连接可写）" }
                  }
                }
              }
            }
          },
          "400": { "description": "筛选或排序参数不合法（FILTER_INVALID / REQUEST_INVALID）" },
          "501": { "description": "无主键表不支持键集分页（CAPABILITY_UNSUPPORTED）" }
        }
      }
    },
    "/api/v1/connections/{id}/tables/{name}/schema": {
      "get": {
        "summary": "表结构详情与 DDL 原文",
        "description": "DDL 还原失败时仍返回结构，另给 ddl_error，不让整页打不开。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "schema", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "ok" },
          "400": { "description": "读取结构失败（SCHEMA_READ_FAILED）" },
          "404": { "description": "连接不存在" }
        }
      }
    },
    "/api/v1/connections/{id}/schema/plan": {
      "post": {
        "summary": "生成结构变更预案",
        "description": "v1 支持 create_table / add_column / drop_column / alter_column_type。执行走同一个 /changes/{pid}/apply；预案带表定义哈希（建表则要求执行时表仍不存在），变了就返回 409 SCHEMA_CHANGED。建表必须给主键。改列类型前会做收窄预检，装不下现存数据返回 409 NARROWING_BLOCKED；SQLite 不支持原地改类型，返回 400。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["table", "action"],
                "properties": {
                  "table": { "type": "object" },
                  "action": { "type": "string", "enum": ["create_table", "add_column", "drop_column", "alter_column_type"] },
                  "column": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string", "description": "原始类型文本，白名单约束" },
                      "nullable": { "type": "boolean" },
                      "default": { "type": "string", "description": "只接受字面量" }
                    }
                  },
                  "columns": { "type": "array", "items": { "type": "object" }, "description": "create_table 用" },
                  "primary_key": { "type": "array", "items": { "type": "string" }, "description": "create_table 用，必须非空" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "预案已生成（语句 / 回滚 / 风险 / 摩擦 / 不可逆标记）" },
          "400": { "description": "参数不合法（INVALID_COLUMN）或生成失败（SCHEMA_PLAN_FAILED）" },
          "409": { "description": "收窄预检不通过（NARROWING_BLOCKED）" },
          "404": { "description": "连接不存在" }
        }
      }
    },
    "/api/v1/connections/{id}/exec": {
      "post": {
        "summary": "执行 SQL（一次性，行数有上限）",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sql"],
                "properties": {
                  "sql": { "type": "string" },
                  "approval_token": {
                    "type": "string",
                    "description": "服务端在 428 响应里签发的审批凭证，绑定语句指纹与 10 分钟有效期。不接受布尔值。"
                  },
                  "max_rows": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "execution_id": { "type": "string" },
                    "risk": { "type": "string" },
                    "friction": { "type": "string" },
                    "duration_ms": { "type": "integer" },
                    "results": { "type": "array", "items": { "$ref": "#/components/schemas/StatementResult" } }
                  }
                }
              }
            }
          },
          "400": { "description": "请求非法" },
          "403": { "description": "只读连接拒绝写入（POLICY_READ_ONLY）" },
          "409": { "description": "审批凭证无效、过期或与语句不匹配（POLICY_APPROVAL_MISMATCH）" },
          "428": {
            "description": "需要确认（POLICY_APPROVAL_REQUIRED），错误体携带 approval.token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "approval": {
                          "type": "object",
                          "properties": {
                            "statement_hash": { "type": "string" },
                            "expires_at": { "type": "string", "format": "date-time" },
                            "token": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connections/{id}/query": {
      "post": {
        "summary": "打开流式游标（仅单条只读语句）",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sql"],
                "properties": {
                  "sql": { "type": "string" },
                  "fetch_size": { "type": "integer", "description": "驱动侧批大小，默认 200" },
                  "max_rows": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "游标已打开",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "execution_id": { "type": "string" },
                    "cursor_id": { "type": "string" },
                    "columns": { "type": "array", "items": { "$ref": "#/components/schemas/Column" } },
                    "risk": { "type": "string" },
                    "friction": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "写语句或多语句被拒绝" }
        }
      }
    },
    "/api/v1/results/{cid}/page": {
      "get": {
        "summary": "拉取一页结果",
        "parameters": [
          { "name": "cid", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 200 } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rows": { "type": "array", "items": { "type": "array" } },
                    "has_more": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "409": { "description": "游标正被读取（CURSOR_BUSY）" },
          "410": { "description": "游标已关闭或过期（CURSOR_CLOSED）" }
        }
      }
    },
    "/api/v1/results/{cid}": {
      "delete": {
        "summary": "主动关闭游标",
        "parameters": [{ "name": "cid", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "已关闭" } }
      }
    },
    "/api/v1/connections/{id}/changes/plan": {
      "post": {
        "summary": "生成数据变更预案（不执行）",
        "description": "预案由服务端保管，客户端只能用 id 回来执行。无主键表返回 501。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["table", "changes"],
                "properties": {
                  "table": {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string" },
                      "schema": { "type": "string" },
                      "name": { "type": "string" }
                    }
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["op"],
                      "properties": {
                        "op": { "type": "string", "enum": ["insert", "update", "delete"] },
                        "key": { "type": "object" },
                        "before": { "type": "object", "description": "原值，用于乐观并发校验与回滚" },
                        "after": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "预案已生成（含 statements / rollback / risk / friction）" },
          "400": { "description": "变更集非法" },
          "501": { "description": "无主键表不支持（CAPABILITY_UNSUPPORTED）" }
        }
      }
    },
    "/api/v1/changes/{pid}/apply": {
      "post": {
        "summary": "执行数据变更预案",
        "description": "单事务执行；任一条影响行数不符即整体回滚并返回 409。",
        "parameters": [{ "name": "pid", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "approval_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已应用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "execution_id": { "type": "string" },
                    "risk": { "type": "string" },
                    "friction": { "type": "string" },
                    "duration_ms": { "type": "integer" },
                    "undo": {
                      "description": "撤销预案（10 分钟内有效）；不可逆变更或撤销本身为 null",
                      "oneOf": [
                        { "type": "null" },
                        {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string", "description": "把它 POST 回 apply 端点即撤销" },
                            "expires_at": { "type": "string", "format": "date-time" },
                            "statements": { "type": "array", "items": { "type": "object" } }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "预案不存在或已清理" },
          "409": { "description": "行冲突（CHANGE_ROW_CONFLICT）或审批凭证不匹配" },
          "428": { "description": "需要确认（POLICY_APPROVAL_REQUIRED）" }
        }
      }
    },
    "/api/v1/connections/{id}/export": {
      "get": {
        "summary": "流式导出表数据（CSV / NDJSON）",
        "description": "单条 SELECT 走游标分批取，内存上限由 page_size 决定。不需要主键，视图与无主键表也能导。CSV 的 NULL 写成空串（与空字符串文本上不可区分）；NDJSON 的 NULL 是真正的 null，BigInt 与二进制分别以字符串、base64 输出以保精度与字节安全。",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "table", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["csv", "ndjson"], "default": "csv" } },
          { "name": "header", "in": "query", "description": "CSV 是否写表头，0 表示不写", "schema": { "type": "string", "default": "1" } },
          { "name": "where", "in": "query", "description": "筛选条件，JSON 数组，与 rows 端点同构", "schema": { "type": "string" } },
          { "name": "order", "in": "query", "description": "排序，JSON 对象", "schema": { "type": "string" } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 500, "maximum": 1000 } }
        ],
        "responses": {
          "200": {
            "description": "文件流。导出行数记在审计里（流写完才知道行数，无法作为响应头返回）。",
            "content": {
              "text/csv": { "schema": { "type": "string" } },
              "application/x-ndjson": { "schema": { "type": "string" } }
            }
          },
          "400": { "description": "参数不合法（EXPORT_FORMAT_UNSUPPORTED / FILTER_INVALID / EXPORT_FAILED）" },
          "404": { "description": "连接不存在" }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "summary": "审计事件",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "at": { "type": "string", "format": "date-time" },
                          "actor": { "type": "string" },
                          "risk": { "type": "string" },
                          "friction": { "type": "string" },
                          "outcome": { "type": "string", "enum": ["ok", "denied", "error"] },
                          "duration_ms": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
